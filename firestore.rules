rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isPublicLiveRoomData(data) {
      return data != null
             && data.status == "live"
             && data.visibility == "public"
             && data.is_private == false;
    }

    function canReadPublicLiveRoom(roomId) {
      return isPublicLiveRoomData(
        get(/databases/$(database)/documents/live_rooms/$(roomId)).data
      );
    }

    match /users/{userId} {
      allow read: if true;
      allow create, update, delete: if isSelf(userId);

      match /wishlist/{itemId} {
        allow read: if true;
        allow create, update, delete: if isSelf(userId);
      }

      match /gallery/{postId} {
        allow read: if true;
        allow create, update, delete: if isSelf(userId);
      }

      match /services/{serviceId} {
        allow read: if true;
        allow create, update, delete: if isSelf(userId);
      }

      match /reviews/{reviewId} {
        allow read: if true;
        allow create, update, delete: if isSelf(userId);
      }

      match /posts/{postId} {
        allow read: if true;
        allow create, update, delete: if isSelf(userId);
      }
    }

    match /creator_requests/{userId} {
      allow read, create, update, delete: if isSelf(userId);
    }

    match /server_time_sync/{userId} {
      allow read, create, update, delete: if isSelf(userId);
    }

    match /conversations/{conversationId} {
      allow read: if signedIn();
      allow create: if signedIn()
                    && request.resource.data.participants is list
                    && request.resource.data.participants.size() >= 2;
      allow update: if signedIn();
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if signedIn();
        allow create: if signedIn()
                      && request.resource.data.sender_id == request.auth.uid
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.conversation_id == conversationId;
        allow update, delete: if false;
      }
    }

    match /wallets/{userId} {
      allow read: if isSelf(userId);
      allow create, update, delete: if false;
    }

    match /wallet_transactions/{txId} {
      allow read: if signedIn() && resource.data.user_id == request.auth.uid;
      allow create, update, delete: if false;
    }

    match /live_rooms/{roomId} {
      allow read: if signedIn() || isPublicLiveRoomData(resource.data);
      allow create, update, delete: if false;

      match /participants/{userId} {
        allow read: if signedIn() || canReadPublicLiveRoom(roomId);
        allow create, update: if isSelf(userId);
        allow delete: if isSelf(userId);
      }

      match /messages/{messageId} {
        allow read: if signedIn();
        allow create: if signedIn()
                      && request.resource.data.sender_id == request.auth.uid
                      && request.resource.data.room_id == roomId
                      && request.resource.data.message_type == "text"
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0;
        allow update, delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
